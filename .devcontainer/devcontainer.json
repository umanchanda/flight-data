{
  "name": "flight-data",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "api/main.py", "frontend/src/App.jsx"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; [ -d frontend ] && cd frontend && npm install",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
    "frontend": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
  },
  "portsAttributes": {
    "5173": {
      "label": "React frontend",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI backend",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [5173, 8000]
}
